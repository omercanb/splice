# name: test_error_message[chained_assignment.py]
  '''
  chained_assignment.py:2:5: error: assigning to multiple targets in one statement is not supported
  
    2 |     a = b = [1, 2, 3]
      |     ^^^^^^^^^^^^^^^^^
  
    help: assign the value once, then copy it to the rest:
            a = [1, 2, 3]
            b = a
  
  '''
