# serializer version: 1
# name: test_statement_effects_snapshot
  '''
  def append_call(a: list[int]) -> None:
      a.append(1)
  
  
  def read_only_call(a: list[int]) -> None:
      a[0]
  
  
  def constructor_call() -> None:
      a: list[int] = list()
  
  
  def list_literal() -> None:
      a = [1, 2, 3]
  
  
  def compound_assign_int(x: int) -> None:
      x += 1
  
  
  def compound_assign_list(a: list[int], b: list[int]) -> None:
      a += b
  
  
  def multiple_findings(a: list[int], b: list[int]) -> None:
      a.append(b.pop())
  
  
  def nested_block(a: list[int], b: list[int]) -> None:
      if a.pop():
          b.append(1)
  
  
  def transitive_alloc() -> None:
      list_literal()
  
  append_call:
    a.append -> mutates=True allocates=True
  read_only_call:
    a.__getitem__ -> mutates=False allocates=False
  constructor_call:
    list() -> mutates=False allocates=True
  list_literal:
    [1, 2, 3] -> mutates=False allocates=True
  compound_assign_int:
    x -> mutates=True allocates=False
  compound_assign_list:
    a -> mutates=True allocates=True
  multiple_findings:
    a.append -> mutates=True allocates=True
    b.pop -> mutates=True allocates=False
  nested_block:
    a.pop -> mutates=True allocates=False
    b.append -> mutates=True allocates=True
  transitive_alloc:
    (no findings)
  '''
# ---
