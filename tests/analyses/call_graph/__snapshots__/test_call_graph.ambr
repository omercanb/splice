# serializer version: 1
# name: test_call_graph
  '''
  class D:
      def __init__(self) -> None:
          pass
  
      def wave(self) -> None:
          print("wave")
  
  
  class C:
      items: list[int]
      d: D
  
      def __init__(self, x: int) -> None:
          self.items = [x]
          self.d = D()
  
      def bye(self) -> None:
          print("bye")
  
      def add(self, x: int) -> None:
          self.items.append(x)
  
      def greet(self) -> None:
          self.bye()
          self.d.wave()
  
  
  def hi() -> None:
      print("hi")
  
  
  def add(a: int, b: int) -> int:
      return a + b
  
  
  def mul(a: int, b: int = 2) -> int:
      return a * b
  
  
  def fact(n: int) -> int:
      if n <= 1:
          return 1
      return n * fact(n - 1)
  
  
  def main() -> int:
      a: list[int] = list()
      i = ord("a")
      print(i)
      hi()
      a.append(i)
      c = C(i)
      c.bye()
      c.add(i)
      c.greet()
  
      num1 = 10
      num2 = 20
      num3 = add(num1, num2)
  
      mul(num1)
      mul(num2, num3)
      fact(num1)
  
      return 0
  
  __init__ -> __init__: D() []
  greet -> bye: self.bye() [self -> self]
  greet -> wave: self.d.wave() [self.d -> self]
  fact -> fact: fact((n - 1)) [(n - 1) -> n]
  main -> hi: hi() []
  main -> __init__: C(i) [i -> x]
  main -> bye: c.bye() [c -> self]
  main -> add: c.add(i) [c -> self, i -> x]
  main -> greet: c.greet() [c -> self]
  main -> add: add(num1, num2) [num1 -> a, num2 -> b]
  main -> mul: mul(num1) [num1 -> a]
  main -> mul: mul(num2, num3) [num2 -> a, num3 -> b]
  main -> fact: fact(num1) [num1 -> n]
  '''
# ---
